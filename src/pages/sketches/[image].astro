---
import AstroImage from "astro/components/Image.astro";
import Layout from "../../layouts/layout.astro";
import Grid from "../../components/grid.astro";
import { Dialog } from "../../components/dialog";
import { getSketches } from "../../utils/getSketches";
import Footer from "../../components/footer.astro";
import { PrevIcon } from "../../icons/prev";
import { NextIcon } from "../../icons/next";
import Header from "../../components/header.astro";
import Nav from "../../components/nav.astro";

export async function getStaticPaths() {
  const images = await getSketches();

  return images.map(({ image, meta }) => {
    return {
      params: { image: meta.name || "" },
      props: { image, meta, images },
    };
  });
}

const { image, images, meta } = Astro.props;
---

<!-- Hex codes: antique white #F4F1DE, terra cotta #E07A5F, deep slate blue #3D405B, muted sage green #81B29A -->
<Layout title="Color Palette">
  <Header />
  <Grid images={images} />
  <Footer />
  <Dialog slot="image" title={meta.name} client:load>
    <div
      class="flex items-end flex-wrap @[1000px]:flex-nowrap h-full gap-2 @[1000px]:items-center justify-between w-full aspect-[16/9]"
    >
      {
        Number(meta.name) > 1 && (
          <a
            class="cursor-pointer"
            href={`${import.meta.env.BASE_URL}/sketches/${(Number(meta.name) - 1).toString()}`.replaceAll(
              "//",
              "/",
            )}
          >
            <PrevIcon />
          </a>
        )
      }
      <AstroImage
        src={image}
        width={1000}
        class="object-contain object-center flex-1 basis-full @[1000px]:basis-0 max-h-full order-first @[1000px]:order-none min-w-0"
        alt={meta?.frontmatter?.alt || ""}
      />
      {
        Number(meta.name) < images.length && (
          <a
            class="cursor-pointer flex justify-end"
            href={`${import.meta.env.BASE_URL}/sketches/${(Number(meta.name) + 1).toString()}`.replaceAll(
              "//",
              "/",
            )}
          >
            <NextIcon />
          </a>
        )
      }
    </div>
  </Dialog>
</Layout>
