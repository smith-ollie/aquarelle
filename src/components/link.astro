---
import { clsx } from "clsx";

const currentPath = Astro.url.pathname;

interface Props {
  href: string;
}

const { href } = Astro.props;

const isActive = currentPath.replace(/\/$/, "") === href.replace(/\/$/, "");
---

<a
  href={href}
  class={clsx(
    "pb-2  font-Archivo text-sm tracking-widest text-black/50 uppercase",
    {
      "border-b-2 border-accent text-black!": isActive,
      "border-transparent": !isActive,
    },
  )}
>
  <slot />
</a>
