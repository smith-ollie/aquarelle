---
import Image from "astro/components/Image.astro";

interface Props {
  images?: Awaited<
    ReturnType<typeof import("../utils/getPaintings").getPaintings>
  >;
  baseUrl?: string;
}

const { images, baseUrl } = Astro.props;
---

<div class="container flex-1 px-4">
  <div
    class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] min-w-full gap-10 relative"
  >
    {
      images?.map(({ image, meta }) => {
        return (
          <div class="grid-item border border-black/10 p-2">
            <a
              class="block aspect-16/10"
              href={`${import.meta.env.BASE_URL}/${baseUrl ? `${baseUrl}/` : ""}${meta.name}`.replaceAll(
                "//",
                "/",
              )}
            >
              <Image
                src={image}
                width={400}
                height={400}
                layout="responsive"
                position={meta?.frontmatter?.["thumbnail-position"] || "center"}
                class={`size-full object-cover ${
                  {
                    "right top": "object-top-right",
                    "left top": "object-top-left",
                    "right bottom": "object-bottom-right",
                    "left bottom": "object-bottom-left",
                    center: "object-center",
                    top: "object-top-right",
                  }[
                    meta?.frontmatter?.["thumbnail-position"]
                      ?.toString()
                      .trim() || "center"
                  ] ?? "object-center"
                }`}
                alt={meta?.frontmatter?.alt || ""}
              />
            </a>
          </div>
        );
      })
    }
    <slot />
  </div>
</div>
