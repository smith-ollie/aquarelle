---
import { clsx } from "clsx";

const currentPath = Astro.url.pathname;

interface Props {
  href: string;
}

const { href } = Astro.props;

const isActive =
  currentPath.replaceAll("/", "") ===
  `${import.meta.env.BASE_URL}${href}`.replaceAll("/", "");
---

<a
  href={href}
  class={clsx("px-2.5 py-1 rounded-lg font-Archivo border", {
    "bg-[#F2F0EF] border-teal-bright": isActive,
    "border-transparent": !isActive,
  })}
>
  <slot />
</a>
